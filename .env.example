# NODE_ENV define el ambiente de ejecución y determina qué variables son obligatorias.
# Valores permitidos: development (DEV), qa (QA), production (PROD), test (TEST).
NODE_ENV=development
PORT=3000

# Requeridas solo en qa y production. En development/test pueden quedar vacías
# porque el servicio usa repositorios en memoria mientras no haya conexión real a BD.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Clave pública (anon). Se usa SOLO para el cliente desechable de sign-in
# (SupabaseAuthIdentityService.authenticate) — nunca para operaciones con
# service-role, para no mutar la sesión del cliente compartido.
SUPABASE_ANON_KEY=your-anon-key

# Conexión directa a PostgreSQL (pg) para operaciones transaccionales, p. ej. el
# reemplazo atómico de categorías del aliado (SCRUM-1071). Requerida en qa y production.
# Es un secreto: nunca commitear su valor. En Supabase usar la cadena del pooler
# (Project Settings > Database); si el certificado no valida, añadir `?sslmode=no-verify`.
# SCRUM-1468: Core se conecta como mani_core_svc (sin BYPASSRLS). En qa/production no arranca con postgres ni con
# otro rol que salte RLS. Credenciales: db/ops/credenciales_roles_servicio.sql
DATABASE_URL=postgresql://mani_core_svc:your-password@db.your-project.supabase.co:5432/postgres

# Secreto para verificar la firma (HS256) de los JWTs emitidos por Supabase Auth.
# Requerida en qa y production; en development/test cae a un secreto inseguro fijo
# (ver src/config/index.js) solo para poder firmar tokens de prueba localmente.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

GATEWAY_URL=http://localhost:80
RULES_SERVICE_URL=http://rules-service:8080
DISPATCH_SERVICE_URL=http://dispatch-service:5000

# Proveedor de notificaciones push (HU-M09-06). Solo existe `mock` (sin FCM ni APNs); otro valor detiene el arranque.
PUSH_PROVIDER=mock
# `mock_falla` hace fallar la entrega push a propósito (SCRUM-1662); no se permite en producción. PUSH_MOCK_FALLAS: `siempre` (por omisión) o
# un entero N para que fallen los N primeros intentos de cada notificación y el reintento entregue.
# PUSH_MOCK_FALLAS=siempre
# Reintentos de la entrega push de los eventos del servicio ante una falla pasajera (0 los desactiva).
PUSH_PROVIDER_RETRIES=1

# Falla inyectable del Storage de KYC (SCRUM-1662), solo fuera de producción: operaciones que fallan (upload, delete,
# createSignedUrl) y cuántas llamadas de cada una funcionan antes de empezar a fallar.
# STORAGE_FALLA=upload
# STORAGE_FALLA_DESPUES_DE=1

# Proveedor de pagos (HU-M11-01). Solo existe `mock` (sandbox, sin dinero ni tarjetas reales); otro valor detiene el arranque.
PAYMENT_PROVIDER=mock

# Tiempo máximo de espera de cada proveedor, en ms (SCRUM-1240). Vacío o inválido usa el valor por omisión.
# Push se reintenta dos veces ante un fallo pasajero; un cobro nunca se reintenta automáticamente.
PUSH_PROVIDER_TIMEOUT_MS=5000
PAYMENT_PROVIDER_TIMEOUT_MS=10000

# Pool de conexiones de Core a PostgreSQL (SCRUM-1651). El máximo es por instancia de Core: instancias x máximo (más lo que
# use Dispatch u otros) debe caber en max_connections de la base (60 en QA). El timeout de espera por una conexión debe ser
# menor o igual que el timeout de Dispatch hacia Core. Vacío o inválido usa el valor por omisión.
DATABASE_POOL_MAX=5
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# Recuperación de contraseña (HU-M02-10): URL de la pantalla de Flutter que abre el enlace del correo,
# p. ej. https://<host>/reset-password. Debe estar permitida en Supabase Auth > URL Configuration.
PASSWORD_RECOVERY_REDIRECT_URL=

# Nunca commitear este archivo con valores reales: copiar a .env (ignorado por git)
# o definir las variables directamente en el entorno/orquestador de cada ambiente.
