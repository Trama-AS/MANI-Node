# NODE_ENV define el ambiente de ejecución y determina qué variables son obligatorias.
# Valores permitidos: development (DEV), qa (QA), production (PROD), test (TEST).
NODE_ENV=development
PORT=3000

# Requeridas solo en qa y production. En development/test pueden quedar vacías
# porque el servicio usa repositorios en memoria mientras no haya conexión real a BD.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

GATEWAY_URL=http://localhost:80
RULES_SERVICE_URL=http://rules-service:8080
DISPATCH_SERVICE_URL=http://dispatch-service:5000

# Nunca commitear este archivo con valores reales: copiar a .env (ignorado por git)
# o definir las variables directamente en el entorno/orquestador de cada ambiente.
