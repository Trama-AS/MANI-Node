      "name": "Ally Registration",
      "description": {
        "content": "Registro de Aliados persona natural",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8faa5329-0fc0-4f0c-ab9d-60134433888f",
          "name": "Registra un nuevo Aliado persona natural",
          "request": {
            "name": "Registra un nuevo Aliado persona natural",
            "description": {
              "content": "Crea el usuario y el perfil de Aliado (rol ALLY) en estado PENDING, a la espera de verificación KYC, dentro del tenant resuelto por `X-Tenant-Id`. Devuelve tokens de sesión (con el claim `tenant_id` ya embebido) para que el Aliado pueda continuar el flujo de onboarding inmediatamente.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "register",
                "ally"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Id del tenant resuelto por MANI-APIGateway a partir del dominio/app-key de origen. Solo se usa en endpoints pre-autenticación; el Gateway es el único llamador autorizado a fijarlo — un cliente final nunca debe poder establecerlo directamente.\n",
                "key": "X-Tenant-Id",
                "value": "{{tenantId}}"
              },
              {
                "disabled": false,
                "description": "Id de trazabilidad distribuida propagado desde el Gateway. Si no se envía, el Core genera uno (`node-<timestamp>`) y lo devuelve en el header de respuesta y en el body de error.\n",
                "key": "X-Correlation-ID",
                "value": "string"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"María Fernanda Rojas\",\n  \"email\": \"{{allyEmail}}\",\n  \"password\": \"{{allyPassword}}\",\n  \"phone\": \"+573001234567\",\n  \"documentType\": \"CC\",\n  \"documentNumber\": \"1020304050\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
