{
  "name": "mani-core-node",
  "version": "1.0.0",
  "description": "Servicio Core Backend del ecosistema MANI (Usuarios, Tenants, Perfiles, KYC, Catalogos)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:openapi": "node scripts/validate-openapi.js",
    "lint:openapi": "spectral lint docs/openapi/core.yaml"
  },
  "keywords": [
    "mani",
    "backend",
    "core",
    "microservices"
  ],
  "author": "TRAMA · Ingenieria de Software",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^9.13.0",
    "@stoplight/spectral-cli": "^6.17.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "supertest": "^7.0.0"
  }
}
